{
  "manifest_version": 3,
  "name": "Discord Autofill",
  "version": "2.0",
  "description": "Autofill Discord login and 2FA code",

  "key": "",

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "content_scripts": [
    {
      "matches": ["https://discord.com/*"],
      "host_permissions": ["https://discord.com/*"],
      "js": ["config.js", "totp.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}