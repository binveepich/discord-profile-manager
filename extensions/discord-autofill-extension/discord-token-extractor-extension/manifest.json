{
  "manifest_version": 3,
  "name": "Discord Token Extractor",
  "version": "0.345",
  "description": "Lấy token Discord từ localStorage và copy vào clipboard",

  "key": "",

  "permissions": [
    "activeTab",
    "scripting",
    "clipboardWrite"
  ],

  "host_permissions": [
    "https://discord.com/*",
    "https://discordapp.com/*"
  ],

  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Lấy token Discord (Chỉ hoạt động trên Discord)"
  },

  "background": {
    "service_worker": "background.js"
  },

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}